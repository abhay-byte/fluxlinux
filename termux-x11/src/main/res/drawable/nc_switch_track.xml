<?xml version="1.0" encoding="utf-8"?>
<!-- Sharp cyber-brutalist switch track — matches app CyberToggle (46×24, 0 radius) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nc_primary" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/nc_primary" />
                    <size
                        android:width="46dp"
                        android:height="24dp" />
                    <corners android:radius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nc_surface_container" />
                    <stroke
                        android:width="2dp"
                        android:color="#333333" />
                    <size
                        android:width="46dp"
                        android:height="24dp" />
                    <corners android:radius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
